{
  "name": "agent-dev-env",
  "version": "0.3.1",
  "description": "Sandbox VM runner and image lifecycle CLI for developer agent sandboxes (macOS, Windows, Ubuntu image recipes).",
  "license": "MIT",
  "author": "Andrey Meshkov <am@adguard.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ameshkov/agent-dev-env.git"
  },
  "homepage": "https://github.com/ameshkov/agent-dev-env#readme",
  "bugs": {
    "url": "https://github.com/ameshkov/agent-dev-env/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "agent-dev-env": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "keywords": [
    "sandbox",
    "vm",
    "virtual-machine",
    "tart",
    "vmware",
    "qemu",
    "packer",
    "developer-environment",
    "cli"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.test.json",
    "prepublishOnly": "node scripts/copy-assets.mjs"
  },
  "dependencies": {
    "commander": "15.0.0",
    "ssh2": "1.17.0"
  }
}
